{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "items"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "scm-multiselect-v1",
        "scm-multiselect-v2"
      ]
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "answer",
          "verification_status",
          "evidence_markdown",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^P[0-9]+-Q[0-9]+$"
          },
          "answer": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "enum": [
                "A",
                "B",
                "C",
                "D"
              ]
            }
          },
          "verification_status": {
            "const": "READY"
          },
          "evidence_markdown": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "type": "object"
          },
          "classification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "taxonomy_version",
              "categories",
              "rationale"
            ],
            "properties": {
              "taxonomy_version": {
                "const": "scm-business-domain-v1"
              },
              "categories": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "strategy_network_design",
                    "planning_inventory_replenishment",
                    "sourcing_procurement_supplier_management",
                    "production_capacity_process_operations",
                    "logistics_distribution_fulfillment"
                  ]
                }
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "scm-multiselect-v2"
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "required": [
                "classification"
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "items": {
            "items": {
              "not": {
                "required": [
                  "classification"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
